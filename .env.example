# Nur zur Generierungszeit von Audiodateien gebraucht (scripts/generate-audio.mjs),
# NIE zur Laufzeit in der App - siehe AUDIO.md.
# Kopieren nach ".env" (bleibt lokal, ist in .gitignore) und mit echtem Key befuellen.

# Nur bei --provider=elevenlabs noetig:
ELEVENLABS_API_KEY=

# Nur bei --provider=piper noetig (lokal installiertes Piper-Binary + Sprachmodell):
PIPER_BIN=piper
PIPER_MODEL=
